# Demojo — server-side configuration. Copy to `.env` and add your key.
# The key is read only by the backend (API + worker). It is never sent to the
# browser; do not put secrets in VITE_* variables.

# Required for AI features (the only secret).
OPENROUTER_API_KEY=

# Models (verified in the OpenRouter catalog on 2026-09-25; see docs/MODELS.md).
OPENROUTER_VISION_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_STORY_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_TTS_MODEL=hexgrad/kokoro-82m
OPENROUTER_TTS_VOICE=af_heart

# Storage and limits. Relative DATA_DIR paths are relative to the repo root.
DATA_DIR=./data
MAX_UPLOAD_MB=350

# App-side budget guard per project for analysis + narration (USD). This is not
# a provider-enforced cap: set a credit limit on the OpenRouter key as well.
AI_PROJECT_BUDGET_USD=3

# Optional "Animate product photo" extension is deferred; leave false.
ENABLE_GENERATIVE_BROLL=false

# openrouter (default) | fixture (no AI calls: deterministic templates + local
# espeak-ng voice, clearly labelled as fixture output in the UI and exports).
DEMOJO_PROVIDER_MODE=openrouter
